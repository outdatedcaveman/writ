{
  "name": "writ-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "node electron/server.cjs",
    "desktop": "electron electron/main.cjs",
    "dist:win": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@fontsource/roboto": "^5.2.10",
    "@fontsource/source-serif-4": "^5.3.0",
    "clsx": "^2.1.1",
    "diff": "^8.0.3",
    "katex": "^0.18.7",
    "lucide-react": "^1.16.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.5.4"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.13.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "autoprefixer": "^10.4.27",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "8.1.3"
  },
  "build": {
    "appId": "com.writ.studio",
    "productName": "Writ",
    "directories": {
      "output": "release"
    },
    "icon": "assets/icon.ico",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": ["portable"]
    },
    "portable": {
      "artifactName": "Writ.exe"
    }
  }
}
